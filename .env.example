# Resend API Key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# 发件人地址（需在 Resend 中验证 uniqmagx.com 域名）
FROM_EMAIL=UNIQMAG <noreply@uniqmagx.com>

# 收件人地址
TO_EMAIL=zach@uniqmagx.com

# C 端 API（可选）。留空则走同源 `/app/v1`（开发时由 Vite 代理到后端）
# 生产若前后端分域，填后端根地址，例如：
# VITE_API_BASE_URL=https://api.uniqmag.cn

# Vite 开发代理目标（默认本地后端）
# VITE_PROXY_TARGET=http://127.0.0.1:8080

# 支付回跳：站点正式域名为 https://www.uniqmag.cn
# 后端 ALIPAY_RETURN_URL 须同 host（见 uniqmag-admin backend/.env）
